PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/civicpulse
NODE_ENV=development
AUTH_MODE=dev-headers
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# AI service: mock (keyword stand-in) or http (the Python CV/NLP service)
AI_MODE=mock
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=20000
AI_MAX_ATTEMPTS=3
AI_RETRY_DELAY_MS=5000

# SMS: console (prints) or twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
